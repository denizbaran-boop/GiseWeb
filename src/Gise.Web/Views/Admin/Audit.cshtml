@model List<AuditLog>
@{
    ViewData["Page"] = "admin-audit";
    string Label(string a) => a switch
    {
        "user.ban" => "Ban", "user.unban" => "Ban kaldırıldı", "user.register" => "Yeni hesap", "user.username" => "Kullanıcı adı",
        "user.email" => "E-posta", "user.password" => "Şifre", "event.publish" => "Etkinlik yayında", "event.unpublish" => "Etkinlik kaldırıldı",
        "event.draft" => "Taslak", "order.paid" => "Sipariş", "ticket.refund" => "İade", _ => a
    };
    string Tone(string a) => a switch { "user.ban" or "event.unpublish" => "bad", "ticket.refund" => "warn", "order.paid" or "event.publish" or "user.unban" => "ok", _ => "neutral" };
}
<main class="page">
    <partial name="_AdminHead" />
    @if (Model.Count == 0)
    {
        <div class="empty">@Ui.Icon("list")<p class="headline">Henüz kayıt yok</p></div>
    }
    else
    {
        <table class="table audit">
            <thead><tr><th>Zaman</th><th>Kim</th><th>İşlem</th><th>Ayrıntı</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr><td class="num footnote" style="font-size:14px;white-space:nowrap">@Ui.DateTimeShort(a.CreatedAt)</td><td><div class="who">@Ui.Avatar(a.ActorName)<span style="font-weight:600">@a.ActorName</span></div></td><td><span class="pill @Tone(a.Action)">@Label(a.Action)</span></td><td class="footnote" style="font-size:14px">@a.Detail</td></tr>
                }
            </tbody>
        </table>
        <p class="section-foot">Son 200 kritik işlem gösteriliyor.</p>
    }
</main>
